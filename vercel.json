{
    "version": 2,
    "builds": [
      {
        "src": "api/index.py",
        "use": "@vercel/python"
      },
      {
        "src": "next.config.js",
        "use": "@vercel/next"
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "api/index.py"
      },
      {
        "src": "/(.*)",
        "dest": "/index.html"
      }
    ],
    "env": {
      "FASTAPI_BACKEND_URL": "https://fastapi-vercel-mu-henna.vercel.app/api",
      "NEXT_PUBLIC_BACKEND_URL": "https://fastapi-vercel-mu-henna.vercel.app/api"
    }
  }
  